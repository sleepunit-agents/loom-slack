#!/usr/bin/env python3
"""loom-slack: loom's Slack venue adapter (loom docs/specs/agent-runtime.md, "The sources").

    loom-slack run                         the intake (the piece's service): shadow or live, by SLACK_MODE
    loom-slack send --place P --agent A    the venue's `send` (the runtime runs it): the text on stdin, posted as
                                           that agent's own bot; answers {ok, id?} or {ok: false, reason,
                                           permanent?, shadow?} (permanent: no retry will ever post it;
                                           shadow: refused only because this adapter is in shadow). A place
                                           dm:<user id> opens that person's DM: one agent's message to a person
        … --describe                       the place's rules, for a body's start: {ok, guest: false, peer: false,
                                           venue, readers: [], members, notes} (Slack routes only tier 2 and up;
                                           members: who's in it, by slug; notes: scope and group-tier names)
        … --status working|done [--message ID]...   a body at work there (the runtime's word): live, the run loop
                                           puts 👀 on the message it took, off once it answers; {ok, stop?}
    loom-slack compare --start T --adapter GLOB --bridge GLOB [--hours 24] [--json] [--check-gone]
                                           the shadow window: this adapter's log against the old bridge's;
                                           --check-gone asks Slack (as the agent's bot, metadata only) whether
                                           each message only the bridge routed still exists: one deleted before
                                           the shadow's late read is `gone`, listed and not counted
    loom-slack status [--json]             the mode, the agents, the log's size, how many are held (no ids, no text)

Shadow (the default): it receives (by reading the Web API slowly: no second socket) and routes, records nothing
and posts nothing, and logs (message id, agent, place) for each message it would deliver. Live: Socket Mode, each
routed message goes to loom's `deliver`, and `send` posts.
"""
import json
import os
import re
import signal
import sys
import time
import urllib.error
from pathlib import Path

HERE = Path(os.path.realpath(__file__)).parent
sys.path.insert(0, str(HERE.parent / "lib"))

from loomvenue import common  # noqa: E402
from loomslack import adapter, routing  # noqa: E402

PIECE = "slack"
VENUE = "slack"
MAX_POST = 3900
NOTE = re.compile(r"^[A-Za-z0-9_.-]{1,64}$")     # a note name, as the runtime takes one (loom-box policy.mjs)
ENV_KEYS = {"bot": "SLACK_BOT_TOKEN", "app": "SLACK_APP_TOKEN", "team": "SLACK_TEAM_ID", "bot_user": "SLACK_BOT_USER_ID"}


def config(env=None):
    env = os.environ if env is None else env
    home = env.get("LOOM_PIECE_HOME") or str(Path.home() / ".local/state/loom-slack")
    mode = common.mode_setting(env, "SLACK_MODE")
    return {
        "mode": mode,
        "bots": common.bots_setting(env, "SLACK_BOTS"),
        "data": common.setting(env, "SLACK_DATA", str(Path(home) / "data")),
        "poll_s": float(common.setting(env, "SLACK_POLL_S", "65" if mode == "shadow" else "5")),
        "thread_lookback_s": float(common.setting(env, "SLACK_THREAD_LOOKBACK_S", str(adapter.THREAD_LOOKBACK_S))),
        "gates": common.argv_setting(env, "SLACK_GATES_COMMAND",
                                     ["loom", "runtime", "gates", "people", "--agent", "{agent}", "--json"]),
        "may": common.argv_setting(env, "SLACK_SECRETS_MAY", ["loom", "secrets", "may", "{agent}", "{name}", "--json"]),
        "get": common.argv_setting(env, "SLACK_SECRETS_GET", ["loom", "secrets", "get", "{name}", "--reveal"]),
        "loom_url": common.setting(env, "SLACK_LOOM_URL", "http://127.0.0.1:8787"),
        "token_file": common.setting(env, "SLACK_TOKEN_FILE"),
        "alert": common.alert_setting(env, "SLACK_ALERT_COMMAND"),
    }


def load_env(text):
    """The bot's credentials: an env file (KEY=value lines), as the secret holds them."""
    out = {}
    for line in (text or "").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def credentials(secrets, agent, name):
    """{bot, app, team, bot_user} for an agent's app, or SecretRefused."""
    env = load_env(secrets.get(agent, name))
    missing = [v for k, v in ENV_KEYS.items() if k != "app" and not env.get(v)]
    if missing:
        raise common.SecretRefused(f"{name} has no {', '.join(missing)}")
    return {k: env.get(v) for k, v in ENV_KEYS.items()}


def under_loom(env=None):
    return (os.environ if env is None else env).get("LOOM_PIECE_NAME") == PIECE


def reexec_under_loom(argv):
    loom = os.environ.get("LOOM_BIN") or "loom"
    os.execvp(loom, [loom, PIECE, *argv])


def make_sink(cfg, deliverer=None, alerter=None):
    """The live sink: True (loom took it, or refused it for good), False (tried again), or common.HOLD (loom refused
    how this adapter wrote it: held and alerted, tried again once the adapter restarts; common.verdict)."""
    deliverer = deliverer or common.Deliverer(cfg["loom_url"], cfg["token_file"])
    alerter = alerter or common.Alerter(cfg.get("alert"))

    def sink(agent, body):
        status, ans = deliverer.deliver(body)
        v = common.verdict(status, ans)
        err = str(ans.get("error"))[:200]
        mid = str(body.get("id", "")).split(":", 1)[-1]
        if v == common.DONE:
            common.log(f"{agent}: delivered {mid} to {ans.get('conversation')} seq {ans.get('seq')}: {ans.get('body')}")
            return True
        if v == common.FINAL:
            common.log(f"{agent}: deliver {mid} REFUSED {status}: {err}; not retried")
            return True
        if v == common.HOLD:
            common.log(f"{agent}: deliver {mid} HELD {status}: {err}; loom refused how this adapter wrote it: "
                       "kept, and tried again once the adapter is updated (restarted)")
            alerter.alert("hold", adapter.SOURCE, "bad",
                          f"loom-slack: loom refused a delivery as malformed ({status}); messages are held, "
                          "not lost, until the adapter is fixed and restarted",
                          status=status, error=err, message=mid, agent=agent)
            return common.HOLD
        common.log(f"{agent}: deliver {mid}: {status or 'no answer'} {err}; tried again")
        return False
    return sink


def run(cfg):
    secrets = common.Secrets(cfg["may"], cfg["get"])
    agents, app_tokens = {}, {}
    for agent, name in sorted(cfg["bots"].items()):
        try:
            c = credentials(secrets, agent, name)
        except common.SecretRefused as e:
            common.log(f"{agent}: no bot: {e}")
            continue
        agents[agent] = adapter.Agent(agent, routing.Slack(c["bot"]), c["team"], c["bot_user"],
                                      common.Doc(common.fill(cfg["gates"], agent=agent), what=f"{agent}'s gates"))
        if c.get("app"):
            app_tokens[agent] = c["app"]
    if not agents:
        common.log("no agent's bot could be read; nothing to read")
        return 1
    shadow = common.ShadowLog(cfg["data"], "slack")
    alerter = common.Alerter(cfg["alert"])
    if cfg["mode"] == "shadow":
        intake = adapter.Poller(adapter.Router(cfg["data"], shadow, alerter=alerter), agents,
                                lookback_s=cfg["thread_lookback_s"])
    else:
        if not cfg["token_file"]:
            common.log("live mode needs SLACK_TOKEN_FILE (a piece token of this piece's, to deliver with)")
            return 1
        missing = sorted(set(agents) - set(app_tokens))
        if missing:
            common.log(f"live mode needs an app token (SLACK_APP_TOKEN) for {', '.join(missing)}")
            return 1
        intake = adapter.Socket(adapter.Router(cfg["data"], shadow, sink=make_sink(cfg, alerter=alerter), alerter=alerter),
                                agents, app_tokens)
        intake.start()
    stopping = []
    presence = common.Presence(cfg["data"])
    signal.signal(signal.SIGTERM, lambda *_: stopping.append(1))
    common.log(f"loom-slack: {cfg['mode']} for {', '.join(sorted(agents))}, every {cfg['poll_s']:g}s")
    while not stopping:
        started = time.time()
        n = intake.tick()
        if n:
            common.log(f"{'would deliver' if cfg['mode'] == 'shadow' else 'delivered'} {n}")
        if cfg["mode"] == "live":
            try:
                presence.show(intake.router.state.setdefault("acked", {}), {a: x.api for a, x in agents.items()}, react)
            except Exception as e:  # noqa: BLE001 - presence never stops the intake
                common.log(f"presence: {type(e).__name__}")
        end = time.time() + max(1.0, cfg["poll_s"] - (time.time() - started))
        while time.time() < end and not stopping:
            time.sleep(0.5)
    if hasattr(intake, "stop"):
        intake.stop()
    return 0


def chunks(text, n=MAX_POST):
    out = []
    while text:
        if len(text) <= n:
            out.append(text)
            break
        cut = text.rfind("\n", 0, n)
        cut = cut if cut > n // 2 else n
        out.append(text[:cut])
        text = text[cut:].lstrip("\n")
    return out


# Slack's errors that are Slack's trouble, not the post's: worth another try. Every other code Slack answers a post
# with (channel_not_found, not_in_channel, is_archived, missing_scope, invalid_auth, msg_too_long, …) is for good.
FOR_NOW = {"fatal_error", "internal_error", "service_unavailable", "request_timeout", "ratelimited"}


def refused_for_good(e):
    """A post Slack refused that no retry will change: an error code not in FOR_NOW, or an HTTP 4xx. A rate limit,
    a timeout, a 5xx or the network is for now."""
    if isinstance(e, routing.SlackError):
        return e.error not in FOR_NOW
    return isinstance(e, urllib.error.HTTPError) and 400 <= e.code < 500 and e.code not in (408, 429)


def send(cfg, argv, stdin=None, secrets=None, api_for=None):
    """{ok, id?} | {ok: false, reason, permanent?}: the text on stdin, posted to the place as the agent's own app.
    `permanent: true` is a refusal for good (agent-runtime.md, "Outbound"): the runtime doesn't retry it or keep it
    for a body, it records it refused. A refusal that may pass later (a rate limit, Slack down, a secret the owner
    hasn't allowed yet) says no `permanent`."""
    def answer(d):
        print(json.dumps(d))
        return 0 if d.get("ok") else 1

    def never(reason):
        return answer({"ok": False, "reason": reason, "permanent": True})
    try:
        place = argv[argv.index("--place") + 1]
        agent = argv[argv.index("--agent") + 1]
    except (ValueError, IndexError):
        return never("usage: loom-slack send --place <place> --agent <agent>")
    if "--describe" in argv:
        return answer(describe(cfg, agent, place, secrets=secrets, api_for=api_for))
    if "--status" in argv:
        i = argv.index("--status")
        state = argv[i + 1] if i + 1 < len(argv) else ""
        msgs = [argv[j + 1] for j, x in enumerate(argv) if x == "--message" and j + 1 < len(argv)]
        return answer(common.Presence(cfg["data"]).status(agent, place, state, msgs))
    if cfg["mode"] != "live":
        # `shadow: true`: the runtime hands a DM it refused this way to the old bridge, which posts there until this
        # adapter is live (loom-box delivery.mjs LEGACY_SEND, t-1920); any other refusal for good stays refused.
        return answer({"ok": False, "reason": "loom-slack is in shadow mode: it posts nothing", "permanent": True, "shadow": True})
    kind, ident, c, refused = place_bot(cfg, agent, place, secrets)
    if refused:
        return never(refused["reason"]) if refused["permanent"] else answer({"ok": False, "reason": refused["reason"]})
    text = (stdin if stdin is not None else sys.stdin).read()
    if not text.strip():
        return never("nothing to send")
    api = (api_for or routing.Slack)(c["bot"])
    first = None
    try:
        channel = api.call("conversations.open", users=ident)["channel"]["id"] if kind == "dm" else ident
        for part in chunks(text):
            got = api.call("chat.postMessage", channel=channel, text=part)
            first = first or got.get("ts")
    except Exception as e:  # noqa: BLE001 - the runtime gets a reason, never a trace
        reason = f"Slack refused the post: {str(e)[:200] if isinstance(e, routing.SlackError) else type(e).__name__}"
        return never(reason) if refused_for_good(e) else answer({"ok": False, "reason": reason})
    common.Presence(cfg["data"]).posted(agent, place)   # the reply is the acknowledgment: 👀 comes off
    return answer({"ok": True, **({"id": f"{channel}:{first}"} if first else {})})


def describe(cfg, agent, place, secrets=None, api_for=None):
    """A Slack place's rules (the runtime's policy.mjs reads them before a body starts): never a guest venue (Slack
    routes only tier 2 and up), never a peer venue; who's in it (`members`, slugs: the runtime gives each one's tier,
    restriction and card from its own gates); and its `notes`, names the agent's policy maps to its own brief files
    (t-1745, the old bridge's ext dm_extra and group briefs):

      - a 1:1 DM with a tier-2 person: `project-<p>` for each of their gates' `projects`, `field-<p>` for each
        `field` project with field sites (scopes are one person's: never a group's, and tier 3 needs none);
      - a group DM: `group-tier-<the lowest tier in it>`, and `group-owner-present` when that's 2 and a tier 3 is in.

    Who's let in is the intake's own gate (routing.Gate: Slack's users.info check and the gates at tier 2 and up, the
    group's members), with the intake's cached answers while they're fresh (it never writes them back). Anyone it
    wouldn't route, Slack or the gates not answering, or a person whose gates slug the runtime couldn't name, is
    {ok: false}: no body starts there."""
    kind, ident, c, refused = place_bot(cfg, agent, place, secrets)
    if refused:
        return {"ok": False, "reason": refused["reason"]}
    gates = common.Doc(common.fill(cfg["gates"], agent=agent), what=f"{agent}'s gates").doc()
    if gates is None:
        return {"ok": False, "reason": f"{agent}'s gates can't be read"}
    gate = routing.Gate(agent, (api_for or routing.Slack)(c["bot"]), c["team"], c["bot_user"], gates,
                        adapter.cached(cfg["data"], agent))
    base = {"ok": True, "guest": False, "peer": False, "venue": ident, "readers": []}
    if kind == "dm":
        verdict, hit = gate.person_gate(ident)
        if verdict != "ok" or not common.SLUG.match(hit[0]) or not isinstance(hit[1].get("tier"), int):
            return {"ok": False, "reason": f"{place}: not someone {agent} routes on Slack (tier 2 and up)"}
        slug, rec = hit
        notes = []
        if rec["tier"] == 2:
            projects = rec.get("projects")
            projects = [projects] if isinstance(projects, str) else projects if isinstance(projects, list) else []
            notes += [f"project-{p}" for p in projects if isinstance(p, str)]
            field = rec.get("field") if isinstance(rec.get("field"), dict) else {}
            notes += [f"field-{p}" for p, sites in field.items() if isinstance(p, str) and sites]
        return {**base, "members": [slug], "notes": sorted({n for n in notes if NOTE.fullmatch(n)})}
    verdict, why = gate.group_gate(ident)
    if verdict != "ok":
        return {"ok": False, "reason": f"{place}: {why}"}
    members = [gate.people[uid] for uid in gate.members(ident) or [] if uid != c["bot_user"]]
    if not all(common.SLUG.match(slug) for slug, _ in members):
        return {"ok": False, "reason": f"{place}: someone in it has a gates slug the runtime can't name"}
    lowest = min(rec["tier"] for _, rec in members)
    notes = [f"group-tier-{lowest}"]
    if lowest == 2 and any(rec["tier"] == 3 for _, rec in members):
        notes.append("group-owner-present")
    return {**base, "members": [slug for slug, _ in sorted(members, key=lambda m: str(m[1].get("name") or m[0]))],
            "notes": sorted({n for n in notes if NOTE.fullmatch(n)})}


def place_bot(cfg, agent, place, secrets=None):
    """(kind, ident, credentials, None) for a Slack place and an agent with a bot, or (…, refusal): what `send` and
    `describe` both check first. A refusal is {reason, permanent}: permanent unless the secret is only not allowed yet."""
    kind, _, ident = place.partition(":")
    if kind not in ("dm", "group") or not ident.isalnum():
        return kind, ident, None, {"reason": f"not a Slack place: {place[:80]}", "permanent": True}
    name = cfg["bots"].get(agent)
    if not name:
        return kind, ident, None, {"reason": f"no Slack bot for {agent}", "permanent": True}
    try:
        return kind, ident, credentials(secrets or common.Secrets(cfg["may"], cfg["get"]), agent, name), None
    except common.SecretRefused as e:
        return kind, ident, None, {"reason": f"{agent}'s bot: {e}", "permanent": False}


def react(api, place, msg_id, add):
    """👀 on (or off) a message, by its id (<channel>:<ts>): True when done, or nothing's left to do."""
    cid, _, ts = str(msg_id).partition(":")
    if not (cid.isalnum() and ts):
        return True
    try:
        api.call("reactions.add" if add else "reactions.remove", channel=cid, timestamp=ts, name="eyes")
        return True
    except routing.SlackError as e:
        return any(x in str(e) for x in ("already_reacted", "no_reaction", "message_not_found", "channel_not_found"))
    except Exception:  # noqa: BLE001 - presence is best effort
        return False


def still_there(api, mid):
    """Whether Slack still has message `<channel>:<ts>`: True, False (gone), or None (Slack didn't say). Reads ts
    fields only: in the timeline (history at that ts), or in a thread (replies has its thread)."""
    cid, _, ts = str(mid).partition(":")
    if not (cid.isalnum() and ts):
        return None
    try:
        d = api.call("conversations.history", channel=cid, oldest=ts, latest=ts, inclusive="true", limit="1")
        if any(m.get("ts") == ts for m in d.get("messages", [])):
            return True
        cursor = None
        for _ in range(50):                  # a thread's pages, oldest first
            params = {"channel": cid, "ts": ts, "limit": "15", **({"cursor": cursor} if cursor else {})}
            d = api.call("conversations.replies", **params)
            if any(m.get("ts") == ts for m in d.get("messages", [])):
                return True
            cursor = (d.get("response_metadata") or {}).get("next_cursor") if d.get("has_more") else None
            if not cursor:
                return False
        return None
    except routing.RateLimited:
        raise                                # the checker waits it out
    except routing.SlackError as e:
        if e.error in ("thread_not_found", "message_not_found"):
            return False
        return None
    except Exception:  # noqa: BLE001 - can't tell: it stays only the bridge's
        return None


def gone_checker(cfg=None, secrets=None, api_for=None, sleep=time.sleep):
    """compare's `gone`, as each agent's own bot. A rate limit waits (up to 70 s) and tries again, twice."""
    def make():
        c = cfg or config()
        sec = secrets or common.Secrets(c["may"], c["get"])
        apis = {}

        def api(agent):
            if agent not in apis:
                creds = credentials(sec, agent, c["bots"][agent])
                apis[agent] = (api_for or routing.Slack)(creds["bot"])
            return apis[agent]

        def gone(mid, pairs):
            agents = [ag for ag, _ in pairs if ag in c["bots"]]
            if not agents:
                return None
            for _ in range(3):
                try:
                    there = still_there(api(agents[0]), mid)
                except routing.RateLimited as e:
                    sleep(min(e.retry_after, 70))
                    continue
                except common.SecretRefused:
                    return None
                return None if there is None else not there
            return None
        return gone
    return make


def status(cfg, as_json):
    p = Path(cfg["data"]) / common.ShadowLog.NAME
    try:
        n = sum(1 for _ in p.open())
    except OSError:
        n = 0
    st = common.load_json(Path(cfg["data"]) / "state.json", {}) or {}
    held = sum(1 for w in (st.get("waiting") or {}).values() if isinstance(w, dict) and w.get("held"))
    d = {"mode": cfg["mode"], "agents": sorted(cfg["bots"]), "shadow_lines": n, "held": held}
    print(json.dumps(d) if as_json else f"{d['mode']}: {', '.join(d['agents']) or 'no agents'}; {n} shadow lines; "
          f"{held} held")
    return 0


def main(argv):
    verb = argv[0] if argv else ""
    if (verb in ("send", "run", "status") or (verb == "compare" and "--check-gone" in argv)) and not under_loom():
        reexec_under_loom(argv)          # the piece's settings and secrets: compare needs them only to ask Slack
    if verb == "compare":
        return common.compare_main(argv[1:], "slack", gone_checker=gone_checker())
    try:
        cfg = config()
    except SystemExit as e:
        if verb == "send":   # its settings don't parse: no retry fixes that
            print(json.dumps({"ok": False, "reason": str(e), "permanent": True}))
            return 1
        raise
    if verb == "run":
        return run(cfg)
    if verb == "send":
        return send(cfg, argv[1:])
    if verb == "status":
        return status(cfg, "--json" in argv)
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
